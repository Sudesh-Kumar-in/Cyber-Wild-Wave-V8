# ══════════════════════════════════════════════════════════════════
# 🔥 CYBER WILD WAVE — Environment Configuration
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Never commit your actual .env to version control.
#
# All API URLs support the {query} placeholder, which is replaced
# at runtime with the user's search input.
# Example: https://api.example.com/lookup?q={query}
# ══════════════════════════════════════════════════════════════════

# ── Bot (Required) ────────────────────────────────────────────────
BOT_TOKEN=YOUR_BOT_TOKEN

# ── Admin (Required) ──────────────────────────────────────────────
# Comma-separated Telegram user IDs
ADMIN_IDS=123456789,987654321

# ── Session Security (Required) ───────────────────────────────────
SESSION_SECRET=change_this_to_a_random_secret

# ── Number Lookup ─────────────────────────────────────────────────
NUMBER_API_URL=
NUMBER_API_KEY=

# ── Aadhaar Lookup ────────────────────────────────────────────────
AADHAAR_API_URL=
AADHAAR_API_KEY=

# ── Family Lookup ─────────────────────────────────────────────────
FAMILY_API_URL=
FAMILY_API_KEY=

# ── IFSC Lookup ───────────────────────────────────────────────────
IFSC_API_URL=
IFSC_API_KEY=

# ── Pincode Lookup ────────────────────────────────────────────────
PINCODE_API_URL=
PINCODE_API_KEY=

# ── Telegram Lookup ───────────────────────────────────────────────
TELEGRAM_API_URL=
TELEGRAM_API_KEY=

# ── Vehicle Lookup ────────────────────────────────────────────────
VEHICLE_API_URL=
VEHICLE_API_KEY=

# ── Optional Settings ─────────────────────────────────────────────
# SQLite database file path (default: bot.db)
DATABASE_PATH=bot.db

# Force-join channel username (e.g. @mychannel), leave blank to disable
REQUIRED_CHANNEL=

# Invite link shown to users who haven't joined the channel
CHANNEL_INVITE_LINK=

# Free searches per user per day (default: 5)
FREE_DAILY_SEARCHES=5

# Minimum seconds between requests per user (default: 3)
RATE_LIMIT_SECONDS=3

# API response cache TTL in seconds (default: 300)
CACHE_TTL=300
